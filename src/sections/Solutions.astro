---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Lang } from '../i18n';
import { t, path } from '../i18n';
import Icon from '../components/Icon.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const imgs = import.meta.glob<{ default: ImageMetadata }>('../assets/solutions/*.png', { eager: true });
const img = (id: string) => imgs[`../assets/solutions/${id}.png`]?.default;
---
<section class="section sol" id="solutions">
  <div class="container">
    <div class="section-head sol__head" data-reveal>
      <p class="eyebrow">{d.solutions.eyebrow}</p>
      <h2 class="title">{d.solutions.title}</h2>
    </div>
  </div>
  <div class="container container--wide">
    <ul class="strip" data-reveal>
      {d.solutions.items.map((s, i) => (
        <li class="panel" id={`sol-${s.id}`} style={`--i:${i}`}>
          <a class="panel__link" href={path(lang, `/solutions/${s.id}`)}>
            <Image src={img(s.id)!} alt="" format="webp" quality={66} widths={[400, 640, 928]} sizes="(min-width: 900px) 36vw, 100vw" class="panel__img" loading="lazy" decoding="async" />
            <span class="panel__shade" aria-hidden="true"></span>
            <span class="panel__icon" aria-hidden="true"><Icon name={s.icon} /></span>
            <span class="panel__go" aria-hidden="true" title={d.solutionPage.view}><Icon name="arrow" class="icon--dir" /></span>
            <div class="panel__body">
              <h3 class="panel__title">{s.title}</h3>
              <div class="panel__more"><p class="panel__desc">{s.short}</p></div>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .sol__head { text-align: center; display: grid; justify-items: center; }
  .container--wide { width: min(100% - 2 * var(--gutter), 1360px); }
  .strip { display: grid; gap: 14px; }
  .panel { position: relative; overflow: hidden; border-radius: var(--radius-lg); background: var(--blue-ink); color: #fff; min-height: 420px; outline-offset: 4px; }
  .panel__link { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: space-between; padding: 20px; isolation: isolate; color: inherit; }
  .panel__link:focus-visible { outline: none; }
  .panel:has(.panel__link:focus-visible) { outline: 2px solid var(--orange); }
  .panel__go { position: absolute; top: 20px; inset-inline-end: 20px; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--orange); color: #fff; opacity: 0; scale: 0.6; transition: opacity 0.4s, scale 0.5s var(--ease-out); box-shadow: 0 10px 24px -10px rgba(241,81,27,0.7); }
  .panel__go .icon { width: 20px; height: 20px; }
  .panel:hover .panel__go, .panel:focus-within .panel__go { opacity: 1; scale: 1; transition-delay: 0.2s; }
  .panel :global(picture) { display: contents; }
  .panel__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; transition: scale 1.2s var(--ease-out), filter 0.6s; filter: saturate(0.85); }
  .panel__shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(0,38,61,0.25) 0%, rgba(0,38,61,0.1) 35%, rgba(0,38,61,0.85) 75%, rgba(0,38,61,0.95) 100%); }
  .panel__icon { align-self: flex-start; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; background: rgba(255,255,255,0.12); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); color: #fff; }
  .panel__icon .icon { width: 22px; height: 22px; }
  .panel__title { font-size: 1.35rem; color: #fff; text-wrap: balance; }
  .panel__more { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.6s var(--ease-out), opacity 0.5s; opacity: 0; }
  .panel__more > * { min-height: 0; overflow: hidden; }
  .panel__desc { padding-block-start: 10px; color: var(--on-dark); font-size: 0.95rem; line-height: 1.5; max-width: 34ch; }
  .panel:hover .panel__img, .panel:focus-within .panel__img, .panel:focus .panel__img { scale: 1.06; filter: saturate(1); }
  .panel:hover .panel__more, .panel:focus .panel__more, .panel:focus-within .panel__more { opacity: 1; }
  /* Desktop: expanding strip. The hovered panel grows, the others shrink. */
  @media (min-width: 900px) {
    /* Fixed text widths (from the strip's container width) so copy never re-wraps while a panel animates. */
    .strip { display: flex; height: clamp(440px, 52vw, 560px); container-type: inline-size; --gaps: 4 * 14px; --pad: 40px; --units: 6.6; --grow: 2.6; }
    .panel__body { width: calc((100cqw - var(--gaps)) * var(--grow) / var(--units) - var(--pad)); max-width: none; }
    .panel__title { width: calc((100cqw - var(--gaps)) / var(--units) - var(--pad)); }
    .panel { flex: 1 1 0; min-height: 0; transition: flex 0.7s var(--ease-out); }
    .panel:hover, .panel:focus, .panel:focus-within { flex: 2.6 1 0; }
    .panel__more { grid-template-rows: 0fr; }
    .panel:hover .panel__more, .panel:focus .panel__more, .panel:focus-within .panel__more { grid-template-rows: 1fr; }
    .panel__title { font-size: clamp(1.1rem, 1.5vw, 1.4rem); }
    .panel__more { transition: grid-template-rows 0.6s var(--ease-out), opacity 0.35s; }
    .panel:hover .panel__more, .panel:focus .panel__more, .panel:focus-within .panel__more { transition-delay: 0s, 0.25s; }
  }
  @media (max-width: 899px) {
    .panel { min-height: 300px; }
    .panel__more { grid-template-rows: 1fr; opacity: 1; }
    .panel__go { opacity: 1; scale: 1; }
  }
  @media (prefers-reduced-motion: reduce) { .panel, .panel__img, .panel__more, .panel__go { transition: none; } }
</style>
