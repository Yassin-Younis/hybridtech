---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Lang } from '../i18n';
import { t } from '../i18n';
import Icon from '../components/Icon.astro';
interface Props { lang: Lang }
const d = t(Astro.props.lang);
const imgs = import.meta.glob<{ default: ImageMetadata }>('../assets/solutions/*.png', { eager: true });
const img = (id: string) => imgs[`../assets/solutions/${id}.png`]?.default;
---
<section class="section sol" id="solutions">
  <div class="container">
    <div class="section-head sol__head" data-reveal>
      <p class="eyebrow">{d.solutions.eyebrow}</p>
      <h2 class="title">{d.solutions.title}</h2>
    </div>
  </div>
  <div class="container container--wide">
    <ul class="strip" data-reveal>
      {d.solutions.items.map((s, i) => (
        <li class="panel" id={`sol-${s.id}`} tabindex="0" style={`--i:${i}`}>
          <Image src={img(s.id)!} alt={s.title} widths={[480, 800, 1100]} sizes="(max-width: 760px) 100vw, 40vw" class="panel__img" loading={i === 0 ? 'eager' : 'lazy'} />
          <div class="panel__shade" aria-hidden="true"></div>
          <div class="panel__top">
            <span class="panel__icon"><Icon name={s.icon} /></span>
            <span class="panel__idx num">0{i + 1}</span>
          </div>
          <div class="panel__body">
            <h3 class="panel__title">{s.title}</h3>
            <div class="panel__more">
              <ul class="panel__list">{s.bullets.slice(0, 4).map((b) => <li><Icon name="check" />{b}</li>)}</ul>
              <p class="panel__vendors">{s.vendors.map((v) => <span class="chip">{v}</span>)}</p>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .sol__head { text-align: center; display: grid; justify-items: center; }
  .container--wide { width: min(100% - 2 * var(--gutter), 1360px); }
  .strip { display: grid; gap: 14px; }
  .panel { position: relative; overflow: hidden; border-radius: var(--radius-lg); background: var(--blue-ink); color: #fff; min-height: 420px; display: flex; flex-direction: column; justify-content: space-between; padding: 20px; isolation: isolate; outline-offset: 4px; cursor: pointer; }
  .panel__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; transition: scale 1.2s var(--ease-out), filter 0.6s; filter: saturate(0.85); }
  .panel__shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(0,38,61,0.25) 0%, rgba(0,38,61,0.1) 35%, rgba(0,38,61,0.85) 75%, rgba(0,38,61,0.95) 100%); }
  .panel__top { display: flex; justify-content: space-between; align-items: center; }
  .panel__icon { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; background: rgba(255,255,255,0.12); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); color: #fff; }
  .panel__icon .icon { width: 22px; height: 22px; }
  .panel__idx { font-family: var(--font-display); font-weight: 600; color: var(--orange); }
  .panel__title { font-size: 1.35rem; color: #fff; text-wrap: balance; }
  .panel__more { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.6s var(--ease-out), opacity 0.5s; opacity: 0; }
  .panel__more > * { min-height: 0; overflow: hidden; }
  .panel__list { display: grid; gap: 6px; margin-block: 12px 12px; }
  .panel__list li { display: flex; gap: 8px; align-items: flex-start; font-size: 0.9rem; line-height: 1.4; color: var(--on-dark); }
  .panel__list .icon { width: 15px; height: 15px; color: var(--orange); margin-top: 3px; }
  .panel__vendors { display: flex; flex-wrap: wrap; gap: 6px; }
  .panel__vendors .chip { background: rgba(255,255,255,0.14); color: #fff; font-size: 0.72rem; }
  .panel:hover .panel__img, .panel:focus-within .panel__img, .panel:focus .panel__img { scale: 1.06; filter: saturate(1); }
  .panel:hover .panel__more, .panel:focus .panel__more, .panel:focus-within .panel__more { opacity: 1; }
  /* Desktop: expanding strip. The hovered panel grows, the others shrink. */
  @media (min-width: 900px) {
    .strip { display: flex; height: clamp(440px, 52vw, 560px); }
    .panel { flex: 1 1 0; min-height: 0; transition: flex 0.7s var(--ease-out); }
    .panel:hover, .panel:focus, .panel:focus-within { flex: 2.6 1 0; }
    .panel__more { grid-template-rows: 0fr; }
    .panel:hover .panel__more, .panel:focus .panel__more, .panel:focus-within .panel__more { grid-template-rows: 1fr; }
    .panel__list { grid-template-columns: 1fr 1fr; gap: 6px 14px; }
    .panel__list li { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block; padding-inline-start: 22px; position: relative; }
    .panel__list li :global(.icon) { position: absolute; inset-inline-start: 0; top: 3px; }
    .panel__title { font-size: clamp(1.1rem, 1.5vw, 1.4rem); }
  }
  @media (max-width: 899px) {
    .panel { min-height: 300px; }
    .panel__more { grid-template-rows: 1fr; opacity: 1; }
    .panel__list li { display: none; }
    .panel__list { margin-block: 8px 10px; }
  }
  @media (prefers-reduced-motion: reduce) { .panel, .panel__img, .panel__more { transition: none; } }
</style>
