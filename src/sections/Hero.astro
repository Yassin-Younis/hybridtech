---
import { Image } from 'astro:assets';
import type { Lang } from '../i18n';
import { t, path } from '../i18n';
import Icon from '../components/Icon.astro';
import CircuitLayer from '../components/CircuitLayer.astro';
import person1 from '../assets/hero/person-1.png';
import person2 from '../assets/hero/person-2.png';
import omar from '../assets/hero/omar.png';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const home = path(lang, '/');
// Depth per layer: 1 = closest to the viewer (follows the pointer most, stays with the page on
// scroll); lower = further back (drifts slower than the page on scroll).
const people = [
  { src: person2, cls: 'hero__person--1', depth: 0.55, alt: '', eager: true },
  { src: person1, cls: 'hero__person--3', depth: 0.7, alt: '', eager: true },
  { src: omar, cls: 'hero__person--2', depth: 1, alt: d.hero.team, eager: true },
];
---
<section class="hero section--dark" id="top">
  <CircuitLayer draw flow />
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="container hero__in">
    <div class="hero__copy">
      <h1 class="hero__h1">
        <span class="eyebrow hero__fade" style="--i:-4">{d.hero.eyebrow}</span>{' '}
        {d.hero.lines.map((line, i) => <span class="hero__line-wrap"><span class="hero__line" style={`--i:${i}`}>{line}</span>{' '}</span>)}
      </h1>
      <p class="lead hero__sub hero__fade" style="--i:0">{d.hero.sub}</p>
      <div class="hero__cta hero__fade" style="--i:1">
        <a class="btn" href={`${home}#solutions`} data-magnetic>{d.hero.primary}<Icon name="arrow" class="icon--dir" /></a>
        <a class="btn btn--ghost" href={`${home}#contact`}>{d.hero.secondary}</a>
      </div>
    </div>
    <div class="hero__stage">
      {people.map((p, i) => (
        <div class={`hero__person hero__layer ${p.cls}`} style={`--d:${p.depth}; --i:${i}`}>
          <Image src={p.src} alt={p.alt} format="webp" quality={68} widths={[320, 480, 640, 900]} sizes="(min-width: 1000px) 30vw, 64vw" loading="eager" fetchpriority={p.depth === 1 ? 'high' : 'auto'} decoding="async" />
        </div>
      ))}
    </div>
  </div>
  <a class="hero__scroll" style="--i:4" href={`${home}#partners`} aria-label={d.hero.scroll}><span>{d.hero.scroll}</span><Icon name="chevron" /></a>
</section>
<script>import '../scripts/hero';</script>
<style>
  .hero { --hero-pb: 56px; position: relative; min-height: calc(100svh - var(--mq-h)); display: grid; align-items: stretch; padding-block: 120px 0; background: radial-gradient(120% 90% at 85% 10%, #0a6a97 0%, var(--blue-deep) 42%, var(--blue-ink) 100%); overflow: hidden; isolation: isolate; }
  .hero__glow { position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background:
      radial-gradient(42% 46% at 76% 62%, rgba(16, 132, 186, 0.55) 0%, rgba(16, 132, 186, 0) 100%),
      radial-gradient(22% 26% at 90% 92%, rgba(241, 81, 27, 0.28) 0%, rgba(241, 81, 27, 0) 100%);
  }
  :global([dir='rtl']) .hero__glow { transform: scaleX(-1); }
  .hero__in { position: relative; z-index: 1; display: grid; gap: 24px; align-items: end; }
  .hero__copy { align-self: center; padding-block-end: 8px; }
  @media (max-width: 999px) {
    .hero { height: calc(100svh - var(--mq-h)); min-height: 540px; padding-block-start: 96px; }
    .hero__in { grid-template-rows: auto minmax(0, 1fr); gap: 0; height: 100%; }
    .hero__copy { align-self: start; padding-block-end: 0; }
    .hero__h1 { font-size: clamp(2rem, 8.4vw, 3.2rem); }
    .hero__h1 .eyebrow { margin-block-end: 14px; font-size: 0.68rem; letter-spacing: 0.22em; }
    .hero__sub { margin-block: 12px 18px; font-size: 1rem; }
    .hero__cta .btn { padding: 0.8em 1.2em; font-size: 0.88rem; }
  }
  @media (max-width: 480px) { .hero__sub { display: none; } .hero__h1 { margin-block-end: 18px; } }
  @media (min-width: 1000px) {
    .hero { --hero-pb: 96px; padding-block-start: 132px; }
    .hero__in { grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr); gap: 0; }
    .hero__copy { position: relative; z-index: 2; padding-block-end: var(--hero-pb); }
  }

  /* Copy */
  .hero__h1 { font-size: clamp(2.5rem, 5.6vw, 4.7rem); line-height: 0.98; letter-spacing: -0.03em; }
  :lang(ar) .hero__h1 { font-size: clamp(2.3rem, 5.6vw, 4.4rem); line-height: 1.25; letter-spacing: 0; }
  .hero__h1 .eyebrow { display: inline-flex; font-size: 0.78rem; margin-block-end: 26px; color: var(--orange); letter-spacing: 0.3em; }
  :lang(ar) .hero__h1 .eyebrow { font-size: 1rem; letter-spacing: 0; }
  .hero__line-wrap { display: block; overflow: hidden; padding-block-end: 0.08em; }
  .hero__line { display: block; }
  .hero__line-wrap:last-child .hero__line { background: linear-gradient(90deg, #fff 30%, #9fd3ec); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .hero__sub { margin-block: 24px 32px; max-width: 44ch; font-size: 1.1rem; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 14px; }


  /* Stage: a fixed-height box so the absolutely positioned layers never shift layout */
  .hero__stage { --px: 0px; --py: 0px; --sx: 0px; --sy: 0px; position: relative; height: auto; min-height: 200px; margin-inline: -8vw; pointer-events: none; }
  @media (min-width: 1000px) { .hero__stage { height: min(62vw, 880px, 100svh - var(--mq-h) - 76px); margin-block-start: -56px; margin-inline: -80px -7vw; } }
  .hero__layer { position: absolute; --d: 1; }
  html.motion-ok .hero__layer { transform: translate3d(calc(var(--px) * var(--d) + var(--sx) * (1 - var(--d))), calc(var(--py) * var(--d) + var(--sy) * (1 - var(--d))), 0); will-change: transform; }


  /* The photo composition keeps one fixed layout in both languages; inline insets on the layers would mirror it in RTL and stack the people. */
  .hero__stage > * { direction: ltr; }
  .hero__person { bottom: 0; }
  .hero__person :global(picture) { display: contents; }
  .hero__person img { display: block; height: 100%; width: auto; max-width: none; mask-image: linear-gradient(to top, transparent 0, #000 16%); -webkit-mask-image: linear-gradient(to top, transparent 0, #000 16%); }
  .hero__person--1 { inset-inline-start: -10%; height: 84%; z-index: 1; filter: brightness(0.86) saturate(0.92); }
  .hero__person--3 { inset-inline-end: -6%; height: 78%; z-index: 2; filter: brightness(0.9) saturate(0.95); }
  .hero__person--2 { inset-inline-start: 18%; height: 90%; z-index: 3; filter: drop-shadow(0 24px 40px rgba(0, 20, 35, 0.55)); }
  /* In RTL the stage sits against the start edge, so the group shifts toward the copy */
  @media (min-width: 1000px) {
    :global([dir='rtl']) .hero__person--1 { inset-inline-start: -4%; }
    :global([dir='rtl']) .hero__person--2 { inset-inline-start: 24%; }
    :global([dir='rtl']) .hero__person--3 { inset-inline-end: -12%; }
  }


  /* Scroll cue */
  .hero__scroll { position: absolute; bottom: 22px; left: 50%; translate: -50% 0; display: none; flex-direction: column; align-items: center; gap: 2px; font-family: var(--font-display); font-size: 0.7rem; letter-spacing: 0.3em; text-transform: uppercase; color: var(--on-dark-muted); z-index: 5; text-shadow: 0 2px 12px rgba(0, 20, 35, 0.6); }
  @media (min-width: 1000px) { .hero__scroll { display: inline-flex; } }
  :lang(ar) .hero__scroll { letter-spacing: 0; font-size: 0.85rem; }
  .hero__scroll span { padding-inline-start: 0.3em; }
  :lang(ar) .hero__scroll span { padding-inline-start: 0; }
  .hero__scroll .icon { width: 18px; height: 18px; animation: bob 2s ease-in-out infinite; }
  @keyframes bob { 50% { translate: 0 5px; } }
  @media (prefers-reduced-motion: reduce) { .hero__scroll .icon { animation: none; } }
  /* Phones/tablets: the stage fills the space under the copy; layers are sized from its height (cqh)
     so the figures scale with the screen. */
  @media (max-width: 999px) {
    .hero__stage { align-self: stretch; container-type: size; margin-inline: calc(-1 * var(--gutter)); }
    .hero__person--2 { height: 90cqh; inset-inline-start: auto; left: calc(50% - 28.9cqh); }
    .hero__person--1 { height: 76cqh; inset-inline-start: max(-14cqh, -10%); }
    .hero__person--3 { height: 70cqh; inset-inline-end: max(-12cqh, -9%); }
    .hero__person img { mask-image: linear-gradient(to top, transparent 0, #000 10%); -webkit-mask-image: linear-gradient(to top, transparent 0, #000 10%); }
  }
</style>
