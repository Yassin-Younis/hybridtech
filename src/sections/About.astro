---
import type { Lang } from '../i18n';
import { t, asset } from '../i18n';
import Icon from '../components/Icon.astro';
import CircuitLayer from '../components/CircuitLayer.astro';
import markSvg from '../../public/brand/mark.svg?raw';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const markVB = markSvg.match(/viewBox="([^"]+)"/)?.[1] ?? '0 0 24 24';
const markPaths = Array.from(markSvg.matchAll(/ d="([^"]+)"/g)).map((m) => m[1]);
const values = d.about.values.items;
---
<section class="section about" id="about">
  <CircuitLayer />
  <div class="container about__grid">
    <div class="about__copy" data-reveal>
      <p class="eyebrow">{d.about.eyebrow}</p>
      <h2 class="title">{d.about.title}</h2>
      <p class="lead">{d.about.body}</p>
      <ul class="about__facts">
        {d.about.facts.map((f) => (
          <li>
            <span class="about__fact-icon"><Icon name={f.icon} /></span>
            <span class="about__fact-k">{f.k}</span>
            <span class="about__fact-v">{f.icon === 'handshake' ? <img src={asset('logos/partners/hp.svg')} alt="HP" width="28" height="28" /> : null}{f.v}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="about__bento">
      <div class="about__orbit card" data-reveal aria-label={d.about.values.t}>
        <p class="about__orbit-title">{d.about.values.t}</p>
        <div class="orbit">
          <svg class="orbit__mark" viewBox={markVB} aria-hidden="true">{markPaths.map((p) => <path d={p} fill="currentColor" />)}</svg>
          <svg class="orbit__rings" viewBox="0 0 400 400" aria-hidden="true" fill="none" stroke="currentColor">
            <circle cx="200" cy="200" r="150" stroke-width="1.5" stroke-dasharray="3 9" />
            <circle cx="200" cy="200" r="110" stroke-width="1" opacity="0.5" />
            <circle cx="200" cy="200" r="190" stroke-width="1" opacity="0.25" />
          </svg>
          <ul class="orbit__ring">
            {values.map((v, i) => (
              <li class="orbit__node" style={`--a:${i * 90}deg`}>
                <span class="orbit__chip"><Icon name={v.icon} /><span>{v.label}</span></span>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <div class="card about__tile about__tile--vision" data-reveal>
        <span class="about__tile-icon"><Icon name="eye" /></span>
        <p class="about__tile-k">{d.about.vision.t}</p>
        <p class="about__tile-v">{d.about.vision.d}</p>
      </div>
      <div class="card about__tile about__tile--mission" data-reveal>
        <span class="about__tile-icon"><Icon name="target" /></span>
        <p class="about__tile-k">{d.about.mission.t}</p>
        <p class="about__tile-v">{d.about.mission.d}</p>
      </div>
    </div>
  </div>
</section>
<style>
  .about__grid { display: grid; gap: 48px; align-items: center; }
  @media (min-width: 1000px) { .about__grid { grid-template-columns: 0.85fr 1.15fr; gap: 72px; } }
  .about__facts { display: grid; gap: 14px; margin-block-start: 36px; }
  .about__facts li { display: grid; grid-template-columns: 44px 1fr; grid-template-rows: auto auto; column-gap: 14px; align-items: center; }
  .about__fact-icon { grid-row: span 2; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; background: var(--blue-tint); color: var(--blue); }
  .about__fact-icon .icon { width: 22px; height: 22px; }
  .about__fact-k { font-family: var(--font-display); font-size: 0.7rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--muted); }
  :lang(ar) .about__fact-k { letter-spacing: 0; font-size: 0.85rem; }
  .about__fact-v { font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; color: var(--blue-deep); display: inline-flex; align-items: center; gap: 8px; }
  .about__fact-v img { width: 26px; height: 26px; border-radius: 50%; }

  .about__bento { display: grid; gap: 16px; grid-template-columns: 1fr 1fr; }
  .about__orbit { grid-column: span 2; padding: 20px 24px 8px; background: var(--paper); overflow: hidden; }
  .about__orbit-title { font-family: var(--font-display); font-size: 0.72rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--muted); }
  :lang(ar) .about__orbit-title { letter-spacing: 0; font-size: 0.9rem; }
  .orbit { position: relative; width: min(100%, 420px); aspect-ratio: 1; margin: -10px auto 0; display: grid; place-items: center; color: var(--blue); }
  .orbit__mark { position: absolute; width: 26%; color: var(--blue); }
  [dir='rtl'] .orbit__mark { transform: scaleX(-1); }
  .orbit__rings { position: absolute; inset: 0; width: 100%; height: 100%; color: var(--line-strong); }
  .orbit__ring { position: absolute; inset: 0; animation: spin 48s linear infinite; }
  .orbit__node { position: absolute; inset: 0; display: grid; place-items: start center; rotate: var(--a); }
  /* Chips sit on the r=150 ring (37.5% of the box); counter-rotate so labels stay upright. */
  .orbit__node { padding-top: 12.5%; }
  .orbit__chip { display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px 8px 10px; border-radius: 999px; background: var(--paper); border: 1px solid var(--line); box-shadow: var(--shadow); font-family: var(--font-display); font-weight: 600; font-size: 0.85rem; color: var(--blue-deep); white-space: nowrap; translate: 0 -50%; rotate: calc(-1 * var(--a)); animation: unspin 48s linear infinite; }
  .orbit__chip .icon { width: 18px; height: 18px; color: var(--orange); }
  @keyframes spin { to { rotate: 360deg; } }
  @keyframes unspin { to { rotate: calc(-1 * var(--a) - 360deg); } }
  .orbit__ring:hover, .orbit__ring:hover .orbit__chip { animation-play-state: paused; }
  @media (prefers-reduced-motion: reduce) { .orbit__ring, .orbit__chip { animation: none; } }
  :lang(ar) .orbit__chip { font-size: 0.95rem; padding-inline: 12px 14px; }

  .about__tile { display: flex; flex-direction: column; gap: 10px; padding: 24px; }
  .about__tile-icon { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 14px; background: var(--blue-tint); color: var(--blue); }
  .about__tile-icon .icon { width: 24px; height: 24px; }
  .about__tile-k { font-family: var(--font-display); font-size: 0.72rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--muted); }
  :lang(ar) .about__tile-k { letter-spacing: 0; font-size: 0.9rem; }
  .about__tile-v { font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; line-height: 1.3; color: var(--blue-deep); text-wrap: balance; }
  .about__tile--mission { background: var(--blue-deep); border-color: var(--blue-deep); }
  .about__tile--mission .about__tile-icon { background: rgba(255,255,255,0.1); color: var(--orange); }
  .about__tile--mission .about__tile-k { color: var(--on-dark-muted); }
  .about__tile--mission .about__tile-v { color: #fff; }
  @media (max-width: 520px) { .about__bento { grid-template-columns: 1fr; } .about__orbit { grid-column: span 1; } .orbit__chip { font-size: 0.75rem; padding: 6px 10px 6px 8px; } }
</style>
