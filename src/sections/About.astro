---
import type { Lang } from '../i18n';
import { t, asset } from '../i18n';
import Icon from '../components/Icon.astro';
import markSvg from '../../public/brand/mark.svg?raw';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const markVB = markSvg.match(/viewBox="([^"]+)"/)?.[1] ?? '0 0 24 24';
const markPaths = Array.from(markSvg.matchAll(/ d="([^"]+)"/g)).map((m) => m[1]);
---
<section class="section about" id="about">
  <div class="about__clip" aria-hidden="true">
    <div class="about__bg">
      <svg class="about__mark" viewBox={markVB} fill="none">
        {markPaths.map((p) => <path class="about__fill" d={p} />)}
        {markPaths.map((p) => <path class="about__stroke" d={p} pathLength="1" />)}
      </svg>
    </div>
  </div>

  <div class="container about__in">
    <p class="eyebrow" data-reveal>{d.about.eyebrow}</p>
    <h2 class="title about__title" data-reveal>{d.about.title}</h2>

    <dl class="about__facts" data-reveal>
      {d.about.facts.map((f) => (
        <div class="about__fact">
          <dt>{f.k}</dt>
          <dd>
            {f.icon === 'handshake' && <img src={asset('logos/partners/hp.svg')} alt="" width="22" height="22" />}
            <bdi>{f.v}</bdi>
          </dd>
        </div>
      ))}
    </dl>

    <ul class="about__values" data-reveal aria-label={d.about.values.t}>
      {d.about.values.items.map((v) => <li><Icon name={v.icon} /><span>{v.label}</span></li>)}
    </ul>
  </div>
</section>

<script>
  // Scroll-linked brand mark. Writes --p (plus eased --draw/--fill) on the section, --p (0 -> 1 as the section
  // travels from "top at viewport bottom" to "bottom at viewport top"); CSS derives the stroke draw-on
  // and the parallax from it. Only runs with motion allowed, and only listens while the section is on
  // screen. Without JS or with reduced motion the mark stays fully drawn and static.
  const section = document.getElementById('about');
  const mq = matchMedia('(prefers-reduced-motion: no-preference)');
  if (section && 'IntersectionObserver' in window) {
    // The scroll position sets a target; the rendered value eases toward it every frame, so wheel
    // steps and flicks glide instead of jumping.
    const TAU = 0.32; // seconds for the glide to cover ~63% of the remaining distance
    const clamp = (v: number) => Math.min(1, Math.max(0, v));
    const smooth = (a: number, b: number, v: number) => { const x = clamp((v - a) / (b - a)); return x * x * x * (x * (x * 6 - 15) + 10); };
    let raf = 0, cur = -1, then = 0, active = false;
    const target = () => {
      const r = section.getBoundingClientRect();
      const vh = innerHeight;
      return clamp((vh - r.top) / (vh + r.height));
    };
    const paint = (p: number) => {
      section.style.setProperty('--p', p.toFixed(4));
      section.style.setProperty('--draw', smooth(0.04, 0.62, p).toFixed(4));
      section.style.setProperty('--fill', smooth(0.34, 0.72, p).toFixed(4));
    };
    const frame = (now = performance.now()) => {
      raf = 0;
      const t = target();
      const dt = then ? Math.min(0.1, (now - then) / 1000) : 0;
      then = now;
      if (cur < 0) cur = t;
      cur += (t - cur) * (1 - Math.exp(-dt / TAU));
      if (Math.abs(t - cur) < 0.0004) cur = t;
      paint(cur);
      if (cur !== t) raf = requestAnimationFrame(frame);
      else then = 0;
    };
    const onScroll = () => { if (!raf) raf = requestAnimationFrame(frame); };
    const listen = (on: boolean) => {
      if (on === active) return;
      active = on;
      if (on) { addEventListener('scroll', onScroll, { passive: true }); addEventListener('resize', onScroll, { passive: true }); onScroll(); }
      else { removeEventListener('scroll', onScroll); removeEventListener('resize', onScroll); cancelAnimationFrame(raf); raf = 0; then = 0; }
    };
    const io = new IntersectionObserver((entries) => listen(entries[entries.length - 1].isIntersecting));
    const apply = () => {
      if (mq.matches) {
        frame();
        section.classList.add('about--scroll');
        io.observe(section);
      } else {
        io.disconnect(); listen(false); cur = -1;
        section.classList.remove('about--scroll');
        ['--p', '--draw', '--fill'].forEach((k) => section.style.removeProperty(k));
      }
    };
    apply();
    mq.addEventListener('change', apply);
  }
</script>

<style>
  .about { padding-block: calc(var(--section) * 0.85); background: var(--paper); overflow: hidden; isolation: isolate; }

  /* Background mark drawn like the hero's arc (bold outlines, faint fill), bleeding off the inline-end edge. The clip layer fades
     it out before the section's bottom edge so it never shows a hard cut above the slanted Stats band. */
  .about__clip { position: absolute; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; -webkit-mask-image: linear-gradient(#000 calc(100% - 90px), transparent 99%); mask-image: linear-gradient(#000 calc(100% - 90px), transparent 99%); }
  .about__bg {
    --w: clamp(420px, 40vw, 600px);
    --dir: 1;
    position: absolute;
    width: var(--w); aspect-ratio: 22.63 / 21.85;
    top: 50%; margin-block-start: calc(var(--w) * -0.46);
    inset-inline-end: calc(var(--w) * -0.04);
    color: var(--blue);
    transform-origin: 91% 93%; /* the quarter-circle's own centre, so it turns along its arc */
  }
  :global([dir='rtl']) .about__bg { --dir: -1; transform-origin: 9% 93%; }
  .about__mark { width: 100%; height: 100%; overflow: visible; }
  :global([dir='rtl']) .about__mark { transform: scaleX(-1); }
  .about__stroke { fill: none; stroke: currentColor; stroke-width: 0.3; stroke-linejoin: round; stroke-opacity: 0.55; stroke-dasharray: 1; stroke-dashoffset: 0; }
  .about__fill { fill: currentColor; opacity: 0.12; }

  /* Scroll-linked state (class added by the script only when motion is allowed).
     Draw: the stroke traces on as the section enters and is complete by the time it is centred;
     the faint fill follows. Parallax: drifts against the scroll, turns a few degrees about the
     arc's centre and grows slightly. */
  .about--scroll .about__bg {
    --k: calc(var(--p, 0.5) - 0.5);
    transform: translate3d(0, calc(var(--k) * 12%), 0) rotate(calc(var(--k) * -8deg * var(--dir))) scale(calc(1 + var(--k) * 0.06));
    will-change: transform;
  }
  .about--scroll .about__stroke { stroke-dashoffset: calc((1 - var(--draw, 1)) * 1px); }
  .about--scroll .about__fill { opacity: calc(var(--fill, 1) * 0.12); }

  /* Content, flat on top */
  .about__in { position: relative; z-index: 1; }
  .about__title { color: var(--blue-deep); max-width: 17ch; margin-block: 0.5em 0; }
  :lang(ar) .about__title { max-width: 19ch; }

  .about__facts { display: grid; grid-template-columns: repeat(3, auto); justify-content: start; gap: 18px clamp(28px, 5vw, 64px); margin: clamp(28px, 4vw, 44px) 0 0; padding-block-start: 22px; border-block-start: 1px solid var(--line); width: fit-content; max-width: 100%; }
  .about__fact { display: grid; gap: 4px; align-content: start; }
  .about__fact dt { font-family: var(--font-display); font-size: 0.64rem; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase; color: var(--muted); line-height: 1.3; }
  :lang(ar) .about__fact dt { letter-spacing: 0; font-size: 0.82rem; }
  .about__fact dd { margin: 0; display: flex; align-items: center; gap: 8px; font-family: var(--font-display); font-weight: 700; font-size: clamp(1.05rem, 1.8vw, 1.3rem); line-height: 1.2; color: var(--blue-deep); }
  .about__fact dd img { width: 22px; height: 22px; flex: none; }

  .about__values { display: flex; flex-wrap: wrap; gap: 12px clamp(20px, 3vw, 36px); margin-block-start: clamp(22px, 3vw, 30px); }
  .about__values li { display: inline-flex; align-items: center; gap: 9px; font-family: var(--font-display); font-weight: 600; font-size: 0.95rem; line-height: 1.25; color: var(--ink); }
  :lang(ar) .about__values li { font-size: 1.05rem; }
  .about__values .icon { width: 18px; height: 18px; color: var(--orange); stroke-width: 1.6; }

  @media (max-width: 640px) {
    .about__bg { --w: 96vw; margin-block-start: calc(var(--w) * -0.2); inset-inline-end: calc(var(--w) * -0.3); }
    .about__stroke { stroke-opacity: 0.32; }
    .about__facts { grid-template-columns: repeat(2, minmax(0, 1fr)); width: auto; }
    .about__fact:last-child { grid-column: 1 / -1; }
    .about__values { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 16px; }
    .about__values li { font-size: 0.9rem; }
  }
</style>
