---
import type { Lang } from '../i18n';
import { t } from '../i18n';
import Icon from '../components/Icon.astro';
import CircuitLayer from '../components/CircuitLayer.astro';
interface Props { lang: Lang }
const d = t(Astro.props.lang);
---
<section class="section about" id="about">
  <CircuitLayer />
  <div class="container">
    <div class="about__grid">
      <div class="about__copy" data-reveal>
        <p class="eyebrow">{d.about.eyebrow}</p>
        <h2 class="title">{d.about.title}</h2>
        <p class="lead">{d.about.body}</p>
        <dl class="about__facts">
          {d.about.facts.map((f) => <div><dt>{f.k}</dt><dd>{f.v}</dd></div>)}
        </dl>
      </div>
      <div class="about__cards">
        <div class="card about__card" data-reveal>
          <h3>{d.about.vision.t}</h3><p>{d.about.vision.d}</p>
        </div>
        <div class="card about__card about__card--accent" data-reveal>
          <h3>{d.about.mission.t}</h3><p>{d.about.mission.d}</p>
        </div>
        <div class="card about__card about__card--values" data-reveal>
          <h3>{d.about.values.t}</h3>
          <ul>{d.about.values.items.map((v) => <li><Icon name="check" />{v}</li>)}</ul>
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  .about__grid { display: grid; gap: 48px; align-items: start; }
  @media (min-width: 960px) { .about__grid { grid-template-columns: 1fr 1fr; gap: 64px; } }
  .about__facts { display: grid; grid-template-columns: repeat(3, auto); gap: 24px; margin-block-start: 36px; justify-content: start; }
  .about__facts dt { font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); font-family: var(--font-display); }
  :lang(ar) .about__facts dt { letter-spacing: 0; font-size: 0.9rem; }
  .about__facts dd { margin: 4px 0 0; font-family: var(--font-display); font-weight: 700; font-size: 1.25rem; color: var(--blue-deep); }
  .about__cards { display: grid; gap: 16px; }
  @media (min-width: 640px) { .about__cards { grid-template-columns: 1fr 1fr; } .about__card--values { grid-column: span 2; } }
  .about__card h3 { font-size: 1.05rem; color: var(--blue); margin-block-end: 10px; letter-spacing: 0.02em; }
  .about__card p { color: var(--muted); }
  .about__card--accent { background: var(--blue-deep); border-color: var(--blue-deep); color: var(--on-dark); }
  .about__card--accent h3 { color: var(--orange); }
  .about__card--accent p { color: var(--on-dark-muted); }
  .about__card--values ul { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 10px; }
  .about__card--values li { display: flex; align-items: center; gap: 10px; font-weight: 600; }
  .about__card--values .icon { width: 18px; height: 18px; color: var(--orange); }
  .about__card::before { content: ''; position: absolute; inset-inline-start: 0; top: 0; width: 4px; height: 100%; background: var(--orange); opacity: 0; transition: opacity 0.3s; }
  .about__card:hover::before { opacity: 1; }
</style>
