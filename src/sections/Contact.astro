---
import type { Lang } from '../i18n';
import { t, pick } from '../i18n';
import { site } from '../data/site';
import { categories } from '../data/categories';
import Icon from '../components/Icon.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const maps = `https://www.google.com/maps?q=${encodeURIComponent(site.mapsQuery)}&output=embed&hl=${lang}`;
const mapsLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.mapsQuery)}`;
const areas = [...d.solutions.items.map((s) => ({ id: s.id, label: s.title })), ...categories.map((c) => ({ id: c.id, label: pick(lang, c.label) }))];
---
<section class="section ct" id="contact">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">{d.contact.eyebrow}</p>
      <h2 class="title">{d.contact.title}</h2>
      <p class="lead">{d.contact.intro}</p>
    </div>
    <div class="ct__grid">
      <form class="card ct__form" id="contact-form" data-reveal data-template={d.contact.template} data-subject={d.contact.emailSubject} data-wa={site.whatsapp} data-email={site.email} novalidate>
        <div class="ct__row">
          <label><span>{d.contact.name}</span><input name="name" type="text" autocomplete="name" required /></label>
          <label><span>{d.contact.company}</span><input name="company" type="text" autocomplete="organization" /></label>
        </div>
        <div class="ct__row">
          <label><span>{d.contact.phone}</span><input name="phone" type="tel" autocomplete="tel" dir="ltr" required /></label>
          <label><span>{d.contact.email}</span><input name="email" type="email" autocomplete="email" dir="ltr" /></label>
        </div>
        <label><span>{d.contact.interest}</span>
          <select name="interest" required>
            <option value="" disabled selected>{d.contact.interestPlaceholder}</option>
            {areas.map((a) => <option value={a.id}>{a.label}</option>)}
          </select>
        </label>
        <label><span>{d.contact.message}</span><textarea name="message" rows="5" placeholder={d.contact.messagePlaceholder}></textarea></label>
        <div class="ct__actions">
          <button class="btn" type="submit" name="via" value="whatsapp"><Icon name="whatsapp" />{d.contact.sendWhatsapp}</button>
          <button class="btn btn--blue" type="submit" name="via" value="email"><Icon name="mail" />{d.contact.sendEmail}</button>
        </div>
      </form>
      <aside class="ct__info" data-reveal>
        <div class="card ct__card">
          <p class="ct__person">{d.contact.person}<span>{d.contact.personRole}</span></p>
          <ul class="ct__list">
            <li><Icon name="phone" /><div><span>{d.contact.phoneLabel}</span><a href={`tel:${site.phoneE164}`}><bdi dir="ltr">{site.phoneDisplay}</bdi></a></div></li>
            <li><Icon name="mail" /><div><span>{d.contact.emailLabel}</span><a href={`mailto:${site.email}`}><bdi dir="ltr">{site.email}</bdi></a></div></li>
            <li><Icon name="pin" /><div><span>{d.contact.addressLabel}</span><a href={mapsLink} target="_blank" rel="noopener">{d.contact.address}</a></div></li>
            <li><Icon name="clock" /><div><span>{d.contact.hoursLabel}</span><p>{d.contact.hours}</p></div></li>
          </ul>
          <a class="btn btn--ghost btn--sm ct__dir" href={mapsLink} target="_blank" rel="noopener">{d.contact.directions}<Icon name="external" /></a>
        </div>
        <div class="ct__map">
          <iframe src={maps} title={d.contact.mapTitle} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
        </div>
      </aside>
    </div>
  </div>
</section>
<style>
  .ct__grid { display: grid; gap: 24px; align-items: start; }
  @media (min-width: 960px) { .ct__grid { grid-template-columns: 1.15fr 0.85fr; } }
  .ct__form { display: grid; gap: 16px; }
  .ct__row { display: grid; gap: 16px; }
  @media (min-width: 560px) { .ct__row { grid-template-columns: 1fr 1fr; } }
  .ct__form label { display: grid; gap: 6px; }
  .ct__form label > span { font-family: var(--font-display); font-size: 0.78rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  :lang(ar) .ct__form label > span { letter-spacing: 0; font-size: 0.9rem; }
  .ct__form input, .ct__form select, .ct__form textarea { font: inherit; color: var(--ink); background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; width: 100%; transition: border-color 0.2s, box-shadow 0.2s; }
  .ct__form input:focus, .ct__form select:focus, .ct__form textarea:focus { outline: none; border-color: var(--blue); box-shadow: 0 0 0 3px rgba(0, 94, 138, 0.15); background: #fff; }
  .ct__form textarea { resize: vertical; min-height: 120px; }
  .ct__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-block-start: 6px; }
  .ct__info { display: grid; gap: 16px; }
  .ct__card { border-color: var(--blue-deep); background: var(--blue-deep); color: var(--on-dark); }
  .ct__person { font-family: var(--font-display); font-weight: 700; font-size: 1.25rem; color: #fff; display: flex; flex-direction: column; margin-block-end: 20px; }
  .ct__person span { font-size: 0.8rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--orange); margin-top: 4px; }
  :lang(ar) .ct__person span { letter-spacing: 0; font-size: 0.9rem; }
  .ct__list { display: grid; gap: 16px; }
  .ct__list li { display: flex; gap: 14px; }
  .ct__list .icon { color: var(--orange); margin-top: 2px; }
  .ct__list span { display: block; font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--on-dark-muted); font-family: var(--font-display); }
  :lang(ar) .ct__list span { letter-spacing: 0; font-size: 0.85rem; }
  .ct__list a, .ct__list p { font-weight: 600; color: #fff; }
  .ct__list a:hover { color: var(--orange); }
  .ct__dir { margin-block-start: 22px; color: #fff; }
  .ct__dir .icon { width: 16px; height: 16px; }
  .ct__map { border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--line); aspect-ratio: 4 / 3; background: var(--surface); }
  .ct__map iframe { width: 100%; height: 100%; border: 0; display: block; }
</style>
