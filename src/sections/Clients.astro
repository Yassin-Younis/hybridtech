---
import type { Lang } from '../i18n';
import { t, asset } from '../i18n';
import { clients } from '../data/clients';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const list = clients.filter((c) => c.logo);
---
<section class="section section--surface cl" id="clients">
  <div class="container">
    <div class="section-head cl__head" data-reveal>
      <p class="eyebrow">{d.clients.eyebrow}</p>
      <h2 class="title">{d.clients.title}</h2>
    </div>
  </div>
  <div class="marquee cl__marquee" data-reveal>
    <div class="marquee__track cl__track">
      {[...list, ...list].map((c) => (
        <div class="cl__logo" title={c.name}>
          <img src={asset(`logos/clients/${c.logo}`)} alt={c.name} loading="lazy" decoding="async" height="44" />
        </div>
      ))}
    </div>
  </div>
</section>
<style>
  .cl { padding-block-end: calc(var(--section) * 0.8); }
  .cl__head { text-align: center; display: grid; justify-items: center; margin-block-end: clamp(28px, 4vw, 44px); }
  .cl__track { animation-duration: 56s; gap: clamp(48px, 7vw, 96px); padding-inline-end: clamp(48px, 7vw, 96px); align-items: center; }
  .cl__logo { display: inline-flex; align-items: center; justify-content: center; height: 56px; }
  .cl__logo img { height: 44px; width: auto; max-width: 190px; object-fit: contain; filter: grayscale(1) opacity(0.75); transition: filter 0.35s; }
  .cl__logo:hover img { filter: none; }
  @media (prefers-reduced-motion: reduce) { .cl__track { row-gap: 32px; } }
</style>
