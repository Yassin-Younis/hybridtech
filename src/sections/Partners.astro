---
import type { Lang } from '../i18n';
import { t, pick } from '../i18n';
import { partners } from '../data/partners';
import BrandTile from '../components/BrandTile.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
---
<section class="section pt" id="partners">
  <div class="container">
    <div class="section-head section-head--split" data-reveal>
      <div><p class="eyebrow">{d.partners.eyebrow}</p><h2 class="title">{d.partners.title}</h2></div>
      <p class="lead">{d.partners.intro}</p>
    </div>
    <ul class="pt__grid">
      {partners.map((p) => (
        <li class="pt__tile" class:list={{ 'pt__tile--hp': p.name === 'HP' }} data-reveal>
          <BrandTile partner={p} />
          <p class="pt__blurb">{pick(lang, p.blurb)}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .pt__grid { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 210px), 1fr)); }
  .pt__tile { border: 1px solid var(--line); border-radius: var(--radius); padding: 24px 20px; display: flex; flex-direction: column; align-items: flex-start; gap: 14px; min-height: 150px; transition: border-color 0.3s, box-shadow 0.3s, translate 0.3s var(--ease-out); background: var(--paper); }
  .pt__tile:hover { border-color: var(--line-strong); box-shadow: var(--shadow); translate: 0 -3px; }
  .pt__tile--hp { grid-column: span 2; background: linear-gradient(135deg, var(--blue-tint), #fff); border-color: var(--blue); }
  @media (max-width: 480px) { .pt__tile--hp { grid-column: span 1; } }
  .pt__blurb { font-size: 0.9rem; color: var(--muted); }
</style>
