---
import type { Lang } from '../i18n';
import { t } from '../i18n';
import CircuitLayer from '../components/CircuitLayer.astro';
import Icon from '../components/Icon.astro';
interface Props { lang: Lang }
const d = t(Astro.props.lang);
---
<section class="section section--dark band why" id="why">
  <CircuitLayer />
  <div class="container why__grid">
    <div class="why__intro" data-reveal>
      <p class="eyebrow">{d.why.eyebrow}</p>
      <h2 class="title">{d.why.title}</h2>
      <p class="why__mark" aria-hidden="true"><span class="num">0{d.why.items.length}</span></p>
    </div>
    <ol class="why__list">
      {d.why.items.map((w, i) => (
        <li class="why__row" data-reveal>
          <span class="why__n num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div class="why__body">
            <h3>{w.t}</h3>
            <p>{w.d}</p>
          </div>
          <Icon name="arrow" class="icon--dir why__arrow" />
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .why { background: linear-gradient(160deg, var(--blue-deep), var(--blue-ink)); }
  .why .title { color: #fff; margin-block-end: 0; }
  .why__grid { display: grid; gap: 48px; align-items: start; }
  @media (min-width: 960px) { .why__grid { grid-template-columns: 0.9fr 1.1fr; gap: 80px; } .why__intro { position: sticky; top: 120px; } }
  .why__mark { margin-block-start: 40px; font-size: clamp(6rem, 14vw, 11rem); line-height: 0.8; font-weight: 700; color: transparent; -webkit-text-stroke: 1px rgba(255,255,255,0.18); user-select: none; }
  .why__list { border-top: 1px solid rgba(255,255,255,0.14); }
  .why__row { display: grid; grid-template-columns: auto 1fr auto; gap: 20px clamp(16px, 3vw, 32px); align-items: start; padding-block: 26px; border-bottom: 1px solid rgba(255,255,255,0.14); transition: padding-inline-start 0.4s var(--ease-out); }
  .why__row:hover { padding-inline-start: 8px; }
  .why__n { font-family: var(--font-display); font-weight: 700; font-size: 1.7rem; line-height: 1.1; color: transparent; -webkit-text-stroke: 1px var(--orange); transition: color 0.3s; min-width: 2ch; }
  .why__row:hover .why__n { color: var(--orange); }
  .why__body h3 { font-size: 1.15rem; color: #fff; margin-block-end: 6px; }
  .why__body p { color: var(--on-dark-muted); max-width: 48ch; }
  .why__arrow { color: var(--orange); opacity: 0; translate: -8px 0; transition: opacity 0.3s, translate 0.4s var(--ease-out); margin-top: 4px; }
  :global([dir='rtl']) .why__arrow { translate: 8px 0; }
  .why__row:hover .why__arrow { opacity: 1; translate: 0 0; }
  @media (max-width: 600px) { .why__arrow { display: none; } .why__row { grid-template-columns: auto 1fr; } }
</style>
