---
import type { Lang } from '../i18n';
import { t } from '../i18n';
import CircuitLayer from '../components/CircuitLayer.astro';
interface Props { lang: Lang }
const d = t(Astro.props.lang);
---
<section class="section section--dark band why" id="why">
  <CircuitLayer />
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">{d.why.eyebrow}</p>
      <h2 class="title">{d.why.title}</h2>
    </div>
    <ol class="why__grid">
      {d.why.items.map((w, i) => (
        <li data-reveal>
          <span class="why__n num">{String(i + 1).padStart(2, '0')}</span>
          <h3>{w.t}</h3>
          <p>{w.d}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .why { background: linear-gradient(160deg, var(--blue-deep), var(--blue-ink)); }
  .why .title { color: #fff; }
  .why__grid { display: grid; gap: 1px; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.1); border-radius: var(--radius-lg); overflow: hidden; }
  @media (min-width: 640px) { .why__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .why__grid { grid-template-columns: repeat(4, 1fr); } }
  .why__grid li { background: var(--blue-deep); padding: 28px 24px 30px; transition: background 0.3s; }
  .why__grid li:hover { background: var(--blue); }
  .why__n { display: block; font-family: var(--font-display); color: var(--orange); font-weight: 600; margin-block-end: 18px; }
  .why__grid h3 { font-size: 1.05rem; color: #fff; margin-block-end: 8px; }
  .why__grid p { color: var(--on-dark-muted); font-size: 0.95rem; }
</style>
