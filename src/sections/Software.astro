---
import type { Lang } from '../i18n';
import { t } from '../i18n';
import { site } from '../data/site';
import Icon from '../components/Icon.astro';
interface Props { lang: Lang }
const d = t(Astro.props.lang);
const s = d.software;
const wa = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(s.waTemplate)}`;
---
<section class="section section--surface sw" id="software">
  <div class="container">
    <div class="section-head section-head--split" data-reveal>
      <div>
        <p class="eyebrow">{s.eyebrow}</p>
        <h2 class="title">{s.title}</h2>
      </div>
      <div class="sw__intro">
        <p class="lead">{s.lead}</p>
        <p class="sw__proof"><Icon name="eye" />{s.proof}</p>
      </div>
    </div>

    <ul class="sw__services">
      {s.services.map((v, i) => (
        <li class="sw__svc" data-reveal style={`--i:${i}`}>
          <span class="sw__icon" aria-hidden="true"><Icon name={v.icon} /></span>
          <h3>{v.t}</h3>
          <p>{v.d}</p>
          <ul class="sw__tags">{v.tags.map((tag) => <li class="chip">{tag}</li>)}</ul>
        </li>
      ))}
    </ul>

    <div class="sw__panel" data-reveal>
      <div class="sw__fixes">
        <h3 class="sw__h">{s.problemsTitle}</h3>
        <ol class="sw__rows">
          {s.problems.map((r) => (
            <li class="sw__row">
              <p class="sw__p"><span class="sr-only">{s.problemLabel}: </span>{r.p}</p>
              <span class="sw__to" aria-hidden="true"><Icon name="arrow" class="icon--dir" /></span>
              <p class="sw__s"><Icon name="check" /><span><span class="sr-only">{s.fixLabel}: </span>{r.s}</span></p>
            </li>
          ))}
        </ol>
      </div>
      <div class="sw__side">
        <h3 class="sw__h">{s.stepsTitle}</h3>
        <ol class="sw__steps">
          {s.steps.map((step, i) => (
            <li><span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{step}</li>
          ))}
        </ol>
        <div class="sw__cta">
          <a class="btn" href="#contact" data-interest="custom-software" data-magnetic>{s.cta}<Icon name="arrow" class="icon--dir" /></a>
          <a class="btn btn--ghost" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" />{s.ctaAlt}</a>
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  .sw__intro { display: grid; gap: 16px; }
  .sw__proof { display: inline-flex; align-items: center; gap: 10px; justify-self: start; font-family: var(--font-display); font-weight: 600; font-size: 0.9rem; color: var(--blue-deep); padding: 8px 14px; border-radius: 999px; background: var(--paper); border: 1px solid var(--line); }
  @media (min-width: 900px) { .sw__proof { justify-self: end; } }
  .sw__proof :global(.icon) { width: 18px; height: 18px; color: var(--orange); }

  /* Services: open columns split by hairlines, not boxed cards. */
  .sw__services { display: grid; border-top: 1px solid var(--line-strong); }
  .sw__svc { display: grid; align-content: start; gap: 10px; padding: 28px 0; border-bottom: 1px solid var(--line); }
  @media (min-width: 640px) { .sw__services { grid-template-columns: 1fr 1fr; column-gap: 32px; } }
  @media (min-width: 1040px) {
    .sw__services { grid-template-columns: repeat(4, 1fr); column-gap: 0; }
    .sw__svc { padding: 32px 28px; border-bottom: 0; border-inline-start: 1px solid var(--line); }
    .sw__svc:first-child { border-inline-start: 0; padding-inline-start: 0; }
  }
  .sw__icon { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 14px; background: var(--paper); color: var(--blue); border: 1px solid var(--line); margin-block-end: 8px; transition: background 0.3s, color 0.3s, border-color 0.3s, rotate 0.5s var(--ease-out); }
  .sw__svc:hover .sw__icon { background: var(--orange); border-color: var(--orange); color: #fff; rotate: -6deg; }
  .sw__svc h3 { font-size: 1.15rem; }
  .sw__svc p { color: var(--muted); max-width: 36ch; }
  .sw__tags { display: flex; flex-wrap: wrap; gap: 6px; margin-block-start: 6px; }

  /* Problems -> fixes, on the brand's deep blue. */
  .sw__panel { margin-block-start: clamp(40px, 6vw, 64px); display: grid; gap: 40px; padding: clamp(26px, 4vw, 48px); border-radius: var(--radius-lg); background: linear-gradient(160deg, var(--blue-deep), var(--blue-ink)); color: var(--on-dark); }
  @media (min-width: 960px) { .sw__panel { grid-template-columns: 1.6fr 1fr; gap: 56px; } }
  .sw__h { font-size: 0.8rem; font-weight: 600; letter-spacing: 0.24em; text-transform: uppercase; color: var(--orange); margin-block-end: 18px; }
  :lang(ar) .sw__h { letter-spacing: 0; font-size: 1rem; }
  .sw__rows { border-top: 1px solid rgba(255,255,255,0.14); }
  .sw__row { display: grid; gap: 8px; padding-block: 18px; border-bottom: 1px solid rgba(255,255,255,0.14); }
  @media (min-width: 700px) { .sw__row { grid-template-columns: 1fr auto 1fr; gap: 20px; align-items: center; } }
  .sw__p { color: var(--on-dark-muted); }
  .sw__to { display: flex; color: var(--orange); }
  .sw__to :global(.icon) { width: 20px; height: 20px; }
  @media (max-width: 699px) { .sw__to { display: none; } }
  .sw__s { display: flex; gap: 10px; align-items: flex-start; color: #fff; font-weight: 600; }
  .sw__s :global(.icon) { width: 20px; height: 20px; color: var(--orange); margin-top: 2px; }

  .sw__side { display: flex; flex-direction: column; }
  .sw__steps { display: grid; }
  .sw__steps li { position: relative; display: flex; align-items: center; gap: 16px; padding-block: 10px; font-family: var(--font-display); font-weight: 600; font-size: 1.05rem; color: #fff; }
  .sw__steps li:not(:last-child)::after { content: ''; position: absolute; inset-inline-start: 19px; top: calc(50% + 20px); height: 20px; width: 1px; background: rgba(255,255,255,0.2); }
  .sw__steps .num { display: grid; place-items: center; width: 40px; height: 40px; flex: none; border-radius: 50%; border: 1px solid var(--orange); color: var(--orange); font-size: 0.85rem; }
  .sw__cta { display: flex; flex-wrap: wrap; gap: 12px; margin-block-start: auto; padding-block-start: 28px; }
  .sw__cta .btn--ghost { color: #fff; }
</style>
