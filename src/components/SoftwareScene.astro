---
// One illustrated scene of the software page: the messy problem (.x) that clears and the fix (.o)
// that rises in, all driven by the inherited --p (0 = problem, 1 = fix; default 1, the finished state).
// Used full-size in each chapter and as the small pictures in the page's top tiles.
import type { Lang } from '../i18n';
import { t } from '../i18n';
import Icon from './Icon.astro';
interface Props { lang: Lang; id: string }
const { lang, id } = Astro.props;
const [web, app, erp, auto] = t(lang).software.chapters;
const bars = [38, 52, 44, 66, 58, 74, 70, 88];
---
<div class="st-box"><div class={`st st--${id}`}>
  <div class="st__glow"></div>

  {id === 'web' && (
    <Fragment>
      <div class="x st-card web-search" style="--tx:6cqw;--ty:14cqw;--r:-3deg">
        <div class="web-bar"><Icon name="search" /><span>{web.scene.query}</span><i class="caret"></i></div>
        {[1, 2, 3].map((n) => (
          <div class="web-res"><b></b><div><strong>{web.scene.competitor} {n}</strong><i></i><i class="short"></i></div></div>
        ))}
        <div class="web-pager"><span>1</span><span>2</span><span>3</span><span>4</span><span class="on">5</span></div>
      </div>
      <div class="x web-lost" style="--tx:-8cqw;--ty:-16cqw;--r:5deg"><Icon name="alert" />{web.scene.you}</div>

      <div class="o st-card web-browser" style="--s:0.42">
        <div class="win-bar"><i></i><i></i><i></i><span>{web.scene.url}</span></div>
        <div class="web-site">
          <div class="web-nav"><b></b><span></span><span></span><span></span><em></em></div>
          <div class="web-hero">
            <div><strong>{web.scene.site}</strong><i></i><i class="short"></i><em></em></div>
            <div class="web-img"></div>
          </div>
          <div class="web-tiles"><span></span><span></span><span></span></div>
        </div>
      </div>
      <div class="o pill web-rank" style="--s:0.56"><span class="stars">★★★★★</span>{web.scene.rank}</div>
      <div class="o toast web-t1" style="--s:0.64"><span class="toast__i"><Icon name="mail" /></span>{web.scene.toast1}</div>
      <div class="o toast web-t2" style="--s:0.72"><span class="toast__i toast__i--wa"><Icon name="whatsapp" /></span>{web.scene.toast2}</div>
    </Fragment>
  )}

  {id === 'app' && (
    <Fragment>
      <div class="x bubble app-b1" style="--tx:14cqw;--ty:10cqw;--r:-4deg">{app.scene.b1}</div>
      <div class="x bubble bubble--end app-b2" style="--tx:-14cqw;--ty:4cqw;--r:3deg">{app.scene.b2}</div>
      <div class="x bubble app-b3" style="--tx:14cqw;--ty:-8cqw;--r:4deg">{app.scene.b3}</div>
      <div class="phone">
        <div class="phone__screen">
          <div class="scr scr--call">
            <div class="call__ring"><span></span><span></span><Icon name="phone" /></div>
            <p class="call__who">{app.scene.calling}</p>
            <p class="call__busy">{app.scene.busy}</p>
            <span class="call__end"><Icon name="phone" /></span>
          </div>
          <div class="scr scr--app">
            <div class="app__top"><b>H</b>{app.scene.app}</div>
            <div class="app__search"><Icon name="search" /><i></i></div>
            <div class="app__banner"></div>
            {app.scene.items.map((item, k) => (
              <div class="app__row"><span class="app__ic"><Icon name={['laptop', 'printer', 'wifi'][k]} /></span><div><strong>{item}</strong><i></i></div><em>+</em></div>
            ))}
            <div class="o app__placed" style="--s:0.62"><Icon name="check" />{app.scene.placed}</div>
          </div>
        </div>
      </div>
      <div class="o app-stores" style="--s:0.54">
        <span class="store"><Icon name="smartphone" /><span><small>Download on the</small>App Store</span></span>
        <span class="store"><Icon name="smartphone" /><span><small>Get it on</small>Google Play</span></span>
      </div>
      <div class="o pill app-stars" style="--s:0.7"><span class="stars">★★★★★</span>4.9</div>
    </Fragment>
  )}

  {id === 'erp' && (
    <Fragment>
      <div class="x st-card erp-sheet" style="--tx:16cqw;--ty:14cqw;--r:-6deg">
        <div class="erp-sheet__tab"><Icon name="table" />{erp.scene.sheet}</div>
        <div class="erp-grid">{Array.from({ length: 20 }, (_, k) => <span class:list={{ bad: k === 6 || k === 13 }}>{k === 13 ? '#REF!' : k === 6 ? '???' : ''}</span>)}</div>
      </div>
      <div class="x erp-note" style="--tx:-14cqw;--ty:12cqw;--r:7deg">{erp.scene.note}</div>
      <div class="x bubble bubble--wa erp-msg" style="--tx:-12cqw;--ty:-12cqw;--r:-4deg">{erp.scene.msg}<small>23:41</small></div>
      <div class="x erp-receipt" style="--tx:14cqw;--ty:-12cqw;--r:5deg"><strong>{erp.scene.receipt}</strong><i></i><i></i><i class="short"></i></div>

      <div class="o st-card erp-dash" style="--s:0.42">
        <aside class="erp-side">
          <b></b>
          {erp.scene.menu.map((m, k) => <span class:list={{ on: k === 1 }}>{m}</span>)}
        </aside>
        <div class="erp-main">
          <div class="erp-kpis">
            <div class="o erp-kpi" style="--s:0.5"><span>{erp.scene.k1}</span><strong>1,248</strong><em class="up">▲ 12%</em></div>
            <div class="o erp-kpi" style="--s:0.55"><span>{erp.scene.k2}</span><strong>37</strong><em class="up">▲ 5</em></div>
            <div class="o erp-kpi" style="--s:0.6"><span>{erp.scene.k3}</span><strong>2</strong><em class="down">▼ 9</em></div>
          </div>
          <div class="erp-chart">
            <span class="erp-chart__t">{erp.scene.chart}</span>
            <div class="erp-bars">{bars.map((h, k) => <span style={`--h:${h}%;--k:${k}`}></span>)}</div>
          </div>
          <div class="o erp-alert" style="--s:0.72"><i></i>{erp.scene.low}</div>
        </div>
      </div>
    </Fragment>
  )}

  {id === 'auto' && (
    <Fragment>
      <svg class="auto-lines" viewBox="0 0 100 80">
        <path class="auto-line auto-line--manual" d="M22 16 H78 V60.8 H22" pathLength="100" />
        <path class="auto-line auto-line--auto" d="M22 16 H78 V60.8 H22" pathLength="100" />
        <path class="auto-line auto-line--pulse" d="M22 16 H78 V60.8 H22" pathLength="100" />
      </svg>
      {[
        { k: 'a', icon: 'mail', label: auto.scene.email },
        { k: 'b', icon: 'table', label: auto.scene.sheet },
        { k: 'c', icon: 'file', label: auto.scene.invoice },
        { k: 'd', icon: 'whatsapp', label: auto.scene.wa },
      ].map((n, k) => (
        <div class={`st-card auto-node auto-node--${n.k}`}>
          <span class="auto-node__i"><Icon name={n.icon} /></span>
          <div><strong>{n.label}</strong><i></i><i class="short"></i></div>
          {n.k === 'b' && <span class="x auto-typo">1O,OOO</span>}
          <span class="o auto-ok" style={`--s:${0.5 + k * 0.06}`}><Icon name="check" /></span>
        </div>
      ))}
      <div class="auto-cursor x"><svg viewBox="0 0 24 24"><path d="M5 3l14 8-6 1.5L10 19z" /></svg><span>Ctrl+V</span></div>
      <div class="auto-badge auto-badge--manual"><Icon name="clock" />{auto.scene.manual}</div>
      <div class="auto-badge auto-badge--auto"><Icon name="spark" />{auto.scene.auto}</div>
    </Fragment>
  )}
</div></div>
<style>
  .st-box {
    --a: clamp(0, (var(--p, 1) - 0.26) / 0.3, 1);   /* the mess clears */
    --b: clamp(0, (var(--p, 1) - 0.4) / 0.3, 1);    /* the fix arrives */
  }
  .st-box { position: relative; width: 100%; max-width: 720px; aspect-ratio: 5 / 4; container-type: inline-size; }
  .st { position: absolute; inset: 0; font-size: max(8px, 2.5cqw); line-height: 1.3; color: var(--ink); pointer-events: none; user-select: none; }
  .st__glow { position: absolute; inset: 6%; border-radius: 50%; background: radial-gradient(closest-side, rgba(0, 94, 138, 0.65), transparent), radial-gradient(closest-side at 70% 70%, rgba(241, 81, 27, calc(0.1 + 0.25 * var(--b))), transparent); filter: blur(20px); }
  .st::before { content: ''; position: absolute; inset: 0; border-radius: 28px; background-image: radial-gradient(rgba(255, 255, 255, 0.12) 1px, transparent 1.2px); background-size: 4.5cqw 4.5cqw; mask-image: radial-gradient(closest-side, #000 40%, transparent); }

  /* Chaos (.x) leaves toward the centre; the fix (.o) rises in, each from its own start --s. */
  .x { position: absolute; opacity: calc(1 - var(--a)); translate: calc(var(--tx, 0cqw) * var(--a) * var(--dir, 1)) calc(var(--ty, 0cqw) * var(--a)); rotate: calc(var(--r, 0deg) * var(--dir, 1) * (1 - 0.6 * var(--a))); scale: calc(1 - 0.4 * var(--a)); }
  .o { --q: clamp(0, (var(--p, 1) - var(--s, 0.42)) / 0.22, 1); position: absolute; opacity: var(--q); translate: 0 calc((1 - var(--q)) * 4cqw); scale: calc(0.94 + 0.06 * var(--q)); }
  .erp-kpi.o, .app__placed.o { position: relative; }

  .st-card { background: #fff; border-radius: 2cqw; box-shadow: 0 3cqw 6cqw -2cqw rgba(0, 10, 20, 0.55), 0 0 0 1px rgba(0, 38, 61, 0.06); }
  .st :global(.icon) { width: 1.25em; height: 1.25em; }
  .st i { display: block; height: 0.55em; border-radius: 1em; background: #e3eaf0; }
  .st i.short { width: 60%; }
  .pill { display: inline-flex; align-items: center; gap: 0.6em; padding: 0.55em 1em; border-radius: 99em; background: #fff; font-family: var(--font-display); font-weight: 700; box-shadow: 0 2cqw 5cqw -1cqw rgba(0, 10, 20, 0.5); white-space: nowrap; }
  .stars { color: #f5a623; letter-spacing: 0.08em; }
  .toast { display: flex; align-items: center; gap: 0.8em; padding-block: 0.8em; padding-inline: 0.8em 1.1em; border-radius: 1.6cqw; background: #fff; font-weight: 600; box-shadow: 0 3cqw 6cqw -2cqw rgba(0, 10, 20, 0.6); white-space: nowrap; }
  .toast__i { display: grid; place-items: center; width: 2.2em; height: 2.2em; border-radius: 0.7em; background: var(--orange-soft); color: var(--orange); }
  .toast__i--wa { background: #dcf8e6; color: #12a150; }
  .bubble { padding: 0.8em 1.1em; border-radius: 1.2em; border-end-start-radius: 0.3em; background: #fff; font-weight: 600; box-shadow: 0 2cqw 5cqw -1cqw rgba(0, 10, 20, 0.5); white-space: nowrap; }
  .bubble--end { border-end-start-radius: 1.2em; border-end-end-radius: 0.3em; }
  .bubble--wa { background: #dcf8c6; display: flex; align-items: flex-end; gap: 0.8em; }
  .bubble--wa small { font-size: 0.75em; color: #5d7a6a; font-weight: 500; }
  .win-bar { display: flex; align-items: center; gap: 0.45em; padding: 0.7em 0.9em; border-bottom: 1px solid #edf1f4; }
  .win-bar i { width: 0.7em; height: 0.7em; border-radius: 50%; background: #ff5f57; }
  .win-bar i:nth-child(2) { background: #febc2e; }
  .win-bar i:nth-child(3) { background: #28c840; }
  .win-bar span { margin-inline-start: 1em; flex: 1; padding: 0.25em 0.9em; border-radius: 99em; background: #f1f4f7; color: var(--muted); font-size: 0.85em; direction: ltr; text-align: start; }

  /* ---------- Scene: website ---------- */
  .web-search { top: 8%; inset-inline-start: 4%; width: 70cqw; padding: 1.2em; }
  .web-bar { display: flex; align-items: center; gap: 0.7em; padding: 0.7em 1em; border-radius: 99em; border: 1px solid #dfe5ea; margin-block-end: 1em; color: var(--muted); }
  .web-bar span { color: var(--ink); font-weight: 600; }
  .st .caret { width: 1.5px; height: 1.2em; border-radius: 0; background: var(--ink); animation: blink 1s steps(1) infinite; }
  .web-res { display: flex; gap: 0.8em; padding-block: 0.65em; border-bottom: 1px solid #f0f3f5; }
  .web-res b { width: 1.6em; height: 1.6em; border-radius: 50%; background: #e3eaf0; flex: none; }
  .web-res div { flex: 1; display: grid; gap: 0.35em; }
  .web-res strong { color: #1a4fd6; font-weight: 600; }
  .web-pager { display: flex; gap: 0.5em; margin-block-start: 0.9em; justify-content: center; color: var(--muted); font-family: var(--font-num); font-weight: 600; }
  .web-pager span { width: 1.8em; height: 1.8em; display: grid; place-items: center; border-radius: 50%; }
  .web-pager .on { background: var(--orange-soft); color: var(--orange); }
  .web-lost { top: 70%; inset-inline-start: 46%; display: inline-flex; align-items: center; gap: 0.6em; padding: 0.7em 1.1em; border-radius: 99em; background: var(--orange); color: #fff; font-family: var(--font-display); font-weight: 700; white-space: nowrap; box-shadow: 0 2cqw 5cqw -1cqw rgba(241, 81, 27, 0.7); }
  .web-browser { top: 7%; inset-inline-start: 6%; width: 82cqw; overflow: hidden; }
  .web-site { padding: 1.2em 1.4em 1.4em; display: grid; gap: 1.2em; }
  .web-nav { display: flex; align-items: center; gap: 1em; }
  .web-nav b { width: 6em; height: 1.2em; border-radius: 0.3em; background: linear-gradient(90deg, var(--blue), var(--orange)); }
  .web-nav span { width: 3em; height: 0.5em; border-radius: 1em; background: #e3eaf0; }
  .web-nav span:first-of-type { margin-inline-start: auto; }
  .web-nav em { width: 4.5em; height: 1.6em; border-radius: 99em; background: var(--orange); }
  .web-hero { display: grid; grid-template-columns: 1fr 1fr; gap: 1.4em; align-items: center; }
  .web-hero > div:first-child { display: grid; gap: 0.6em; }
  .web-hero strong { font-family: var(--font-display); font-size: 1.9em; line-height: 1.1; color: var(--blue-ink); }
  .web-hero em { width: 7em; height: 2em; border-radius: 99em; background: var(--orange); margin-block-start: 0.3em; }
  .web-img { aspect-ratio: 4 / 3; border-radius: 1.2cqw; background: radial-gradient(circle at 70% 30%, rgba(241, 81, 27, 0.6), transparent 45%), linear-gradient(140deg, var(--blue), var(--blue-ink)); }
  .web-tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.8em; }
  .web-tiles span { height: 3.2em; border-radius: 0.8cqw; background: #f1f5f8; }
  .web-rank { top: 0%; inset-inline-end: 2%; }
  .web-t1 { top: 63%; inset-inline-start: 48%; }
  .web-t2 { top: 80%; inset-inline-start: 34%; }

  /* ---------- Scene: mobile app ---------- */
  .phone { position: absolute; top: 3%; inset-inline-start: 31cqw; width: 38cqw; height: 94%; padding: 1.2cqw; border-radius: 6cqw; background: #0a1520; box-shadow: 0 4cqw 8cqw -2cqw rgba(0, 0, 0, 0.7), inset 0 0 0 1px rgba(255, 255, 255, 0.12); }
  .phone__screen { position: relative; height: 100%; border-radius: 5cqw; overflow: hidden; background: #fff; }
  .phone__screen::before { content: ''; position: absolute; top: 1.2cqw; left: 50%; translate: -50% 0; width: 10cqw; height: 2.6cqw; border-radius: 99em; background: #0a1520; z-index: 3; }
  .scr { position: absolute; inset: 0; }
  .scr--call { opacity: calc(1 - var(--a)); background: linear-gradient(180deg, #1d2b38, #0d1822); color: #fff; display: grid; justify-items: center; align-content: center; gap: 0.6em; text-align: center; }
  .call__ring { position: relative; display: grid; place-items: center; width: 9cqw; height: 9cqw; border-radius: 50%; background: rgba(255, 255, 255, 0.1); margin-block-end: 0.8em; }
  .call__ring span { position: absolute; inset: 0; border-radius: 50%; border: 1px solid rgba(255, 255, 255, 0.35); animation: ring 2s ease-out infinite; }
  .call__ring span + span { animation-delay: 1s; }
  .call__who { font-family: var(--font-display); font-size: 1.15em; font-weight: 600; }
  .call__busy { color: #ff6b5b; font-weight: 600; animation: blink 1.2s steps(1) infinite; }
  .call__end { position: absolute; bottom: 9%; left: 50%; translate: -50% 0; display: grid; place-items: center; width: 8cqw; height: 8cqw; border-radius: 50%; background: #ff3b30; }
  .call__end :global(.icon) { rotate: 135deg; }
  .scr--app { opacity: var(--b); translate: 0 calc((1 - var(--b)) * 3cqw); padding: 5.5cqw 1.8cqw 1.8cqw; display: flex; flex-direction: column; gap: 0.75em; }
  .app__top { display: flex; align-items: center; gap: 0.6em; font-family: var(--font-display); font-weight: 700; font-size: 1.05em; color: var(--blue-ink); }
  .app__top b { display: grid; place-items: center; width: 1.7em; height: 1.7em; border-radius: 0.5em; background: var(--orange); color: #fff; font-size: 0.85em; }
  .app__search { display: flex; align-items: center; gap: 0.5em; padding: 0.5em 0.7em; border-radius: 99em; background: #f1f4f7; color: var(--muted); }
  .app__search i { flex: 1; }
  .app__banner { height: 6.5cqw; border-radius: 1.4cqw; background: radial-gradient(circle at 80% 30%, rgba(241, 81, 27, 0.75), transparent 50%), linear-gradient(120deg, var(--blue), var(--blue-ink)); flex: none; }
  .app__row { display: flex; align-items: center; gap: 0.6em; }
  .app__ic { display: grid; place-items: center; width: 2.3em; height: 2.3em; border-radius: 0.7em; background: var(--blue-tint); color: var(--blue); flex: none; }
  .app__row div { flex: 1; display: grid; gap: 0.3em; }
  .app__row strong { font-size: 0.95em; }
  .app__row i { width: 50%; }
  .app__row em { display: grid; place-items: center; width: 1.7em; height: 1.7em; border-radius: 50%; background: var(--orange); color: #fff; font-style: normal; font-weight: 700; }
  .app__placed { margin-top: auto; display: flex; align-items: center; justify-content: center; gap: 0.5em; padding: 0.7em; border-radius: 1em; background: #12a150; color: #fff; font-weight: 700; }
  .app-b1 { top: 10%; inset-inline-start: 0%; }
  .app-b2 { top: 40%; inset-inline-start: 66%; }
  .app-b3 { top: 70%; inset-inline-start: 6%; }
  .app-stores { top: 34%; inset-inline-start: 73%; display: grid; gap: 0.8em; }
  .store { display: flex; align-items: center; gap: 0.6em; padding: 0.6em 1em 0.6em 0.8em; border-radius: 0.9em; background: #000; color: #fff; font-family: var(--font-display); font-weight: 700; box-shadow: 0 2cqw 5cqw -1cqw rgba(0, 0, 0, 0.6); white-space: nowrap; direction: ltr; }
  .store small { display: block; font-size: 0.65em; font-weight: 500; opacity: 0.8; }
  .app-stars { top: 62%; inset-inline-start: 4%; }

  /* ---------- Scene: business system (ERP) ---------- */
  .erp-sheet { top: 6%; inset-inline-start: 3%; width: 50cqw; overflow: hidden; }
  .erp-sheet__tab { display: flex; align-items: center; gap: 0.5em; padding: 0.6em 0.9em; background: #1f7244; color: #fff; font-weight: 600; direction: ltr; }
  .erp-grid { display: grid; grid-template-columns: repeat(5, 1fr); }
  .erp-grid span { height: 2.1em; border-inline-end: 1px solid #e6ebef; border-bottom: 1px solid #e6ebef; font-size: 0.8em; display: grid; place-items: center; font-weight: 700; }
  .erp-grid span.bad { background: #fde3dc; color: #c4321a; }
  .erp-note { top: 8%; inset-inline-start: 60%; width: 30cqw; padding: 1.1em; background: #ffe58a; color: #5a4300; font-weight: 700; font-size: 1.05em; box-shadow: 0 2cqw 5cqw -1cqw rgba(0, 0, 0, 0.5); border-radius: 0.3em; }
  .erp-msg { top: 58%; inset-inline-start: 52%; }
  .erp-receipt { top: 52%; inset-inline-start: 8%; width: 26cqw; padding: 1em 1em 1.6em; background: #fff; display: grid; gap: 0.55em; box-shadow: 0 2cqw 5cqw -1cqw rgba(0, 0, 0, 0.5); mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50% / 1.4em 100%; }
  .erp-receipt strong { color: #c4321a; }
  .erp-dash { top: 6%; inset-inline-start: 4%; width: 92cqw; height: 86%; display: grid; grid-template-columns: 24% 1fr; overflow: hidden; }
  .erp-side { background: var(--blue-ink); color: var(--on-dark-muted); padding: 1.2em 0.8em; display: flex; flex-direction: column; gap: 0.35em; font-weight: 600; }
  .erp-side b { width: 70%; height: 1.2em; border-radius: 0.3em; background: linear-gradient(90deg, #fff, var(--orange)); margin-block-end: 1em; opacity: 0.9; }
  .erp-side span { padding: 0.5em 0.7em; border-radius: 0.6em; }
  .erp-side span.on { background: rgba(255, 255, 255, 0.1); color: #fff; box-shadow: inset 3px 0 0 var(--orange); }
  :global([dir='rtl']) .erp-side span.on { box-shadow: inset -3px 0 0 var(--orange); }
  .erp-main { padding: 1.2em; display: flex; flex-direction: column; gap: 1em; background: #f6f8fa; min-width: 0; }
  .erp-kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.8em; }
  .erp-kpi { padding: 0.8em 0.9em; border-radius: 1cqw; background: #fff; display: grid; gap: 0.15em; box-shadow: 0 0 0 1px #e6ebef; }
  .erp-kpi span { color: var(--muted); font-size: 0.85em; }
  .erp-kpi strong { font-family: var(--font-num); font-size: 1.8em; color: var(--blue-ink); line-height: 1.1; }
  .erp-kpi em { font-style: normal; font-size: 0.8em; font-weight: 700; }
  .erp-kpi .up { color: #12a150; }
  .erp-kpi .down { color: var(--orange); }
  .erp-chart { flex: 1; padding: 0.9em; border-radius: 1cqw; background: #fff; box-shadow: 0 0 0 1px #e6ebef; display: flex; flex-direction: column; }
  .erp-chart__t { font-weight: 700; color: var(--blue-ink); }
