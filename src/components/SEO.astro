---
import type { Lang } from '../i18n';
import { path, asset, t } from '../i18n';
import { site } from '../data/site';
interface Props { lang: Lang; title: string; description: string; page: string }
const { lang, title, description, page } = Astro.props;
const origin = Astro.site?.origin ?? '';
const url = (l: Lang) => origin + path(l, page);
const og = origin + asset(`og/og-${lang}.png`);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': url('en'),
  name: site.name,
  alternateName: site.nameAr,
  url: origin + path('en', '/'),
  logo: origin + asset('brand/logo.svg'),
  image: og,
  telephone: site.phoneE164,
  email: site.email,
  foundingDate: site.founded,
  address: { '@type': 'PostalAddress', streetAddress: site.address.street, addressLocality: `${site.address.area}, ${site.address.city}`, postalCode: site.address.postal, addressCountry: site.address.country },
  areaServed: 'Egypt',
  openingHoursSpecification: [{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday'], opens: '09:00', closes: '18:00' }],
  knowsAbout: ['IT infrastructure', 'Enterprise networking', 'Network security', 'Managed print services', 'Managed IT services', 'Microsoft 365', 'HP', 'Dell', 'Cisco', 'Fortinet'],
  ...(site.socials.length ? { sameAs: site.socials.map((s) => s.url) } : {}),
};
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={url(lang)} />
<link rel="alternate" hreflang="en" href={url('en')} />
<link rel="alternate" hreflang="ar" href={url('ar')} />
<link rel="alternate" hreflang="x-default" href={url('en')} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={lang === 'ar' ? site.nameAr : site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url(lang)} />
<meta property="og:image" content={og} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={lang === 'ar' ? 'ar_EG' : 'en_US'} />
<meta property="og:locale:alternate" content={lang === 'ar' ? 'en_US' : 'ar_EG'} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={og} />
<meta name="theme-color" content="#00466b" />
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
