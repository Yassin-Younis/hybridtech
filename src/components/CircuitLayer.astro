---
import { circuit } from '../data/circuit';
interface Props { class?: string; parallax?: boolean; draw?: boolean }
const { class: cls = '', parallax = true, draw = false } = Astro.props;
---
<div class={`circuit ${cls}`} data-parallax={parallax ? '' : undefined} aria-hidden="true">
  <svg viewBox={`0 0 ${circuit.w} ${circuit.h}`} fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" class:list={{ 'circuit--draw': draw }}>
    {circuit.paths.map((d) => <path d={d} pathLength="1" />)}
    {circuit.nodes.map(([x, y]) => <circle class="node" cx={x} cy={y} r="7" fill="currentColor" stroke="none" />)}
    {circuit.nodes.map(([x, y]) => <circle cx={x} cy={y} r="13" />)}
    {circuit.pads.map(([x, y]) => <rect x={x - 9} y={y - 9} width="18" height="18" rx="3" />)}
  </svg>
</div>
<style>
  html.motion-ok .circuit--draw path { stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 3s var(--ease-out) forwards; }
  html.motion-ok .circuit--draw path:nth-child(2n) { animation-delay: 0.4s; }
  html.motion-ok .circuit--draw path:nth-child(3n) { animation-delay: 0.8s; }
</style>
