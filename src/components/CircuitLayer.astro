---
import { circuit } from '../data/circuit';
interface Props { class?: string; parallax?: boolean; draw?: boolean; flow?: boolean }
const { class: cls = '', parallax = true, draw = false, flow = false } = Astro.props;
// Deterministic per-trace timing so pulses never march in lockstep.
const rand = (i: number) => { const x = Math.sin(i * 12.9898 + 78.233) * 43758.5453; return x - Math.floor(x); };
const pulses = flow ? circuit.paths.map((d, i) => ({ d, dur: 3.2 + rand(i) * 4.2, delay: -rand(i + 7) * 7, rev: rand(i + 3) > 0.55, hot: rand(i + 11) > 0.72 })) : [];
---
<div class:list={['circuit', cls, { 'circuit--flow': flow }]} data-parallax={parallax ? '' : undefined} aria-hidden="true">
  <svg viewBox={`0 0 ${circuit.w} ${circuit.h}`} fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" class:list={{ 'circuit--draw': draw }}>
    <g class="circuit__drift">
      <g class="circuit__base">
        {circuit.paths.map((d) => <path class="circuit__trace" d={d} pathLength="1" />)}
        {circuit.nodes.map(([x, y]) => <circle class="node" cx={x} cy={y} r="7" fill="currentColor" stroke="none" />)}
        {circuit.nodes.map(([x, y]) => <circle cx={x} cy={y} r="13" />)}
        {circuit.pads.map(([x, y]) => <rect x={x - 9} y={y - 9} width="18" height="18" rx="3" />)}
      </g>
      {flow && (
        <g class="circuit__flow">
          {pulses.map((p) => (
            <g class:list={['circuit__pulse', { 'is-rev': p.rev, 'is-hot': p.hot }]} style={`--dur:${p.dur.toFixed(2)}s; --delay:${p.delay.toFixed(2)}s`}>
              <path class="circuit__halo" d={p.d} pathLength="1" />
              <path class="circuit__spark" d={p.d} pathLength="1" />
            </g>
          ))}
          {circuit.nodes.map(([x, y], i) => (
            <circle class="circuit__ping" cx={x} cy={y} r="13" style={`--delay:${(-rand(i + 21) * 5).toFixed(2)}s; --dur:${(3.5 + rand(i + 31) * 3).toFixed(2)}s`} />
          ))}
        </g>
      )}
    </g>
  </svg>
</div>
<style>
  html.motion-ok .circuit--draw .circuit__trace { stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 3s var(--ease-out) forwards; }
  html.motion-ok .circuit--draw .circuit__trace:nth-child(2n) { animation-delay: 0.4s; }
  html.motion-ok .circuit--draw .circuit__trace:nth-child(3n) { animation-delay: 0.8s; }

  /* Flow variant (hero): the board is live. Faint traces, bright pulses of current running along them,
     solder nodes that ping, and the whole board drifting slowly. Only with motion allowed. */
  .circuit--flow { color: #8fd3f4; }
  .circuit--flow svg { opacity: 1; }
  .circuit--flow .circuit__base { opacity: 0.14; }
  .circuit__flow { display: none; }
  html.motion-ok .circuit--flow .circuit__flow { display: inline; }
  html.motion-ok .circuit--flow .circuit__drift { animation: boardDrift 26s ease-in-out infinite alternate; }

  /* The dash starts and ends fully off the path (with a gap longer than the path) so the loop seam is invisible. */
  .circuit__pulse path { stroke-dasharray: 0.09 2; stroke-dashoffset: 0.1; animation: current var(--dur) cubic-bezier(0.45, 0, 0.55, 1) var(--delay) infinite; }
  .circuit__pulse.is-rev path { animation-direction: reverse; }
  .circuit__halo { stroke: #38b6ff; stroke-width: 12; opacity: 0.18; }
  .circuit__spark { stroke: #d9f3ff; stroke-width: 2.6; opacity: 0.85; }
  .circuit__pulse.is-hot .circuit__halo { stroke: var(--orange); opacity: 0.28; }
  .circuit__pulse.is-hot .circuit__spark { stroke: #ffc2a8; }
  .circuit__pulse.is-hot path { stroke-dasharray: 0.05 2; stroke-dashoffset: 0.06; }

  .circuit__ping { stroke: #8fd3f4; stroke-width: 2; opacity: 0; transform-box: fill-box; transform-origin: center; animation: ping var(--dur) ease-out var(--delay) infinite; }

  .circuit--flow { -webkit-mask-image: linear-gradient(transparent 0, #000 150px); mask-image: linear-gradient(transparent 0, #000 150px); }
  .circuit--flow.is-paused * { animation-play-state: paused !important; }
  @media (max-width: 640px) { .circuit__pulse:nth-child(3n), .circuit__ping:nth-child(2n) { display: none; } }

  @keyframes current { to { stroke-dashoffset: -1.01; } }
  @keyframes ping { 0%, 62% { opacity: 0; scale: 0.6; } 70% { opacity: 0.7; } 100% { opacity: 0; scale: 2.4; } }
  @keyframes boardDrift { from { translate: 0 0; } to { translate: -40px 18px; } }
</style>
<script>
  // Stop the current flowing while the hero is off screen.
  document.querySelectorAll<HTMLElement>('.circuit--flow').forEach((el) => {
    if (!('IntersectionObserver' in window)) return;
    new IntersectionObserver(([e]) => el.classList.toggle('is-paused', !e.isIntersecting)).observe(el);
  });
</script>
