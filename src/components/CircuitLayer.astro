---
import { circuit } from '../data/circuit';
interface Props { class?: string; parallax?: boolean; draw?: boolean; flow?: boolean }
const { class: cls = '', parallax = true, draw = false, flow = false } = Astro.props;
---
<div class:list={['circuit', cls, { 'circuit--flow': flow }]} data-parallax={parallax ? '' : undefined} aria-hidden="true">
  <svg viewBox={`0 0 ${circuit.w} ${circuit.h}`} fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" class:list={{ 'circuit--draw': draw }}>
    <g class="circuit__base">
      {circuit.paths.map((d) => <path class="circuit__trace" d={d} pathLength="1" />)}
      {circuit.nodes.map(([x, y]) => <circle class="node" cx={x} cy={y} r="7" fill="currentColor" stroke="none" />)}
      {circuit.nodes.map(([x, y]) => <circle cx={x} cy={y} r="13" />)}
      {circuit.pads.map(([x, y]) => <rect x={x - 9} y={y - 9} width="18" height="18" rx="3" />)}
    </g>
  </svg>
  {flow && <canvas class="circuit__canvas" width={circuit.w} height={circuit.h}></canvas>}
</div>
<style>
  html.motion-ok .circuit--draw .circuit__trace { stroke-dasharray: 1 2; stroke-dashoffset: 1.01; animation: draw 3s var(--ease-out) forwards; }
  html.motion-ok .circuit--draw .circuit__trace:nth-child(2n) { animation-delay: 0.4s; }
  html.motion-ok .circuit--draw .circuit__trace:nth-child(3n) { animation-delay: 0.8s; }

  /* Flow variant (hero): the board is live. Faint traces, bright pulses of current running along them,
     solder nodes that ping, and the whole board drifting slowly. Only with motion allowed.
     The live board is drawn on the canvas by scripts/circuit-render.ts (keyframes, timings and colours
     live there); the SVG is the static board for reduced motion / no JS and until the first canvas frame. */
  .circuit--flow { color: #8fd3f4; }
  .circuit--flow svg { opacity: 1; }
  .circuit--flow .circuit__base { opacity: 0.14; }
  /* Same box as `.circuit svg` (base.css, incl. the img/svg max-width reset) so the two line up exactly. */
  .circuit__canvas { position: absolute; display: block; width: max(1200px, 100%); max-width: 100%; height: auto; aspect-ratio: 1400 / 800; inset-inline-end: -8%; top: -6%; visibility: hidden; }
  .circuit--flow.is-live .circuit__canvas { visibility: visible; }
  .circuit--flow.is-live svg { display: none; }

  .circuit--flow { -webkit-mask-image: linear-gradient(transparent 0, #000 150px); mask-image: linear-gradient(transparent 0, #000 150px); }
  /* Off screen, nothing on the board animates (solder-node pulses included). */
  .circuit.is-paused * { animation-play-state: paused !important; }
  @media (max-width: 767px) { .circuit--flow { display: none; } }
</style>
<script>
  // Nothing on a board animates while it is off screen (the hero's live board also stops its clock,
  // scripts/circuit-flow.ts).
  document.querySelectorAll<HTMLElement>('.circuit').forEach((el) => {
    if (!('IntersectionObserver' in window)) return;
    new IntersectionObserver(([e]) => el.classList.toggle('is-paused', !e.isIntersecting)).observe(el);
  });
</script>
