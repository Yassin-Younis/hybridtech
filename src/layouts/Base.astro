---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/motion.css';
import type { Lang } from '../i18n';
import { dirOf, path, asset, otherLang } from '../i18n';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import Intro from '../components/Intro.astro';
// Above-the-fold faces per language (same hashed assets fonts.css points at), preloaded so the
// hero heading and first paragraph don't wait for style/layout to discover them.
import chakra700 from '@fontsource/chakra-petch/files/chakra-petch-latin-700-normal.woff2?url';
import instrument400 from '@fontsource/instrument-sans/files/instrument-sans-latin-400-normal.woff2?url';
import messiri700 from '@fontsource/el-messiri/files/el-messiri-arabic-700-normal.woff2?url';
import messiri400 from '@fontsource/el-messiri/files/el-messiri-arabic-400-normal.woff2?url';
interface Props { lang: Lang; title: string; description: string; page: string; jsonLd?: Record<string, unknown>[] }
const { lang, title, description, page, jsonLd } = Astro.props;
const alt = path(otherLang(lang), page);
const preloadFonts = lang === 'ar' ? [messiri700, messiri400] : [chakra700, instrument400];
---
<!doctype html>
<html lang={lang} dir={dirOf(lang)} data-alt={alt}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Language preference: honour a stored choice (or the browser's Arabic) once per session.
      (function () {
        try {
          var h = document.documentElement, cur = h.lang, key = 'hy_lang';
          var pref = localStorage.getItem(key);
          if (!pref) { pref = /^ar\b/i.test(navigator.language || '') ? 'ar' : 'en'; localStorage.setItem(key, pref); }
          if (pref !== cur && !sessionStorage.getItem('hy_redir')) { sessionStorage.setItem('hy_redir', '1'); location.replace(h.dataset.alt + location.hash); return; }
          // Logo intro: every page load, never with reduced motion (Intro.astro).
          if (matchMedia('(prefers-reduced-motion: no-preference)').matches) {
            h.classList.add('hy-intro');
            // Failsafe if the intro script never runs: release the waiting hero and header.
            setTimeout(function () { if (h.classList.contains('hy-intro')) h.classList.add('hy-intro-go'); }, 6500);
          }
        } catch (e) {}
      })();
    </script>
    {preloadFonts.map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={asset('favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
    <link rel="manifest" href={asset('site.webmanifest')} />
    <SEO {lang} {title} {description} {page} {jsonLd} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <Intro />
    <Header {lang} {page} />
    <main id="main"><slot /></main>
    <Footer {lang} {page} />
    <WhatsAppFab {lang} />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
