---
// /solutions/: the solutions overview (moved off the homepage, which now only links here) and the contact form.
import type { Lang } from '../i18n';
import { t, path } from '../i18n';
import Base from '../layouts/Base.astro';
import CircuitLayer from '../components/CircuitLayer.astro';
import Solutions from '../sections/Solutions.astro';
import Contact from '../sections/Contact.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const origin = Astro.site?.origin ?? '';
const home = path(lang, '/');
const pageUrl = origin + path(lang, '/solutions');
const jsonLd = [
  {
    '@type': 'BreadcrumbList',
    '@id': `${pageUrl}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: d.nav.home, item: origin + home },
      { '@type': 'ListItem', position: 2, name: d.nav.solutions, item: pageUrl },
    ],
  },
  {
    '@type': 'ItemList',
    '@id': `${pageUrl}#solutions`,
    name: d.solutions.title,
    itemListElement: [
      ...d.solutions.items.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.title, url: origin + path(lang, `/solutions/${s.id}`) })),
      { '@type': 'ListItem', position: d.solutions.items.length + 1, name: d.solutions.supply.title, url: origin + path(lang, '/products') },
    ],
  },
];
---
<Base lang={lang} title={d.solutions.pageTitle} description={d.solutions.pageDescription} page="/solutions" {jsonLd}>
  <section class="sh section--dark">
    <CircuitLayer />
    <div class="container">
      <nav class="sh__crumbs" aria-label={d.solutionPage.breadcrumb}><a href={home}>{d.nav.home}</a><span aria-hidden="true">/</span><span aria-current="page">{d.nav.solutions}</span></nav>
      <p class="eyebrow">{d.solutions.eyebrow}</p>
      <h1 class="title sh__title">{d.solutions.title}</h1>
      <p class="lead">{d.solutions.intro}</p>
    </div>
  </section>
  <Solutions lang={lang} head={false} />
  <Contact lang={lang} />
</Base>
<style>
  .sh { position: relative; padding-block: 150px 72px; background: radial-gradient(120% 90% at 85% 10%, #0a6a97 0%, var(--blue-deep) 42%, var(--blue-ink) 100%); overflow: hidden; }
  .sh__title { color: #fff; }
  .sh__crumbs { display: flex; flex-wrap: wrap; gap: 10px; margin-block-end: 22px; font-family: var(--font-display); font-size: 0.85rem; color: var(--on-dark-muted); }
  .sh__crumbs a { color: #fff; opacity: 0.85; }
  .sh__crumbs a:hover { color: var(--orange); opacity: 1; }
</style>
