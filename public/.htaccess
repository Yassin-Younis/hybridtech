# Apache settings for the static Astro build on the data4host (CWP) server. Lives in public/ so every deploy ships it.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # One canonical origin: https://hybridtech-eg.com (leave AutoSSL's /.well-known/ checks alone)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/avif .avif
  AddType image/webp .webp
</IfModule>

# Pages and data revalidate on every visit, so a publish from /admin/ shows up at once.
# Photos, logos and PDFs keep their names when replaced, so they get a short cache; hashed /_astro/
# files are cached for a year by public/_astro/.htaccess. Done with mod_headers because the
# data4host server has no mod_expires.
<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=86400"
  <FilesMatch "\.(html|json|xml|txt|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# FTP-Deploy-Action's bookkeeping file (see .github/workflows/deploy.yml) is not for visitors.
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>

# Brochure links download the PDF instead of opening it in the tab.
<IfModule mod_headers.c>
  <FilesMatch "\.pdf$">
    Header set Content-Disposition "attachment"
  </FilesMatch>
</IfModule>
